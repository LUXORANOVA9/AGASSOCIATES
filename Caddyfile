# AG Platform — LegalTech case management (Vite SPA + Express).
# The main product is served at the root domain. The legacy `app.` subdomain
# is preserved as a 301 redirect for backwards compatibility (any existing
# bookmarks, links, or OAuth callback URLs).
app.{$DOMAIN} {
	encode zstd gzip
	redir https://{$DOMAIN}{uri} permanent
}

# Root domain — the full AG Platform app (Vite SPA + Express API under /api/*).
# Caddy reverse-proxies everything to ag-platform:3000; Express handles SPA
# routing (production `*all` → dist/index.html) and the /api/* JSON routes.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy ag-platform:3000 {
		health_uri /api/health
		health_interval 30s
	}
}

# www. — redirect to bare domain (SEO convention, prevents duplicate content).
www.{$DOMAIN} {
	encode zstd gzip
	redir https://{$DOMAIN}{uri} permanent
}

# AI Dashboard — Next.js status / workflow viewer
dashboard.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy ai-dashboard:3000
}

# AI Backend API — FastAPI agents
api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy ai-backend:8000 {
		health_uri /health
		health_interval 30s
	}
}

# Intake API — SMS webhook, OTP bridge, bank intake
intake.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy intake-api:3002 {
		health_uri /health
		health_interval 30s
	}
}

# n8n orchestration UI — protected by Caddy basicauth on top of n8n's own auth
n8n.{$DOMAIN} {
	encode zstd gzip
	basic_auth {
		{$N8N_BASIC_AUTH_USER} {$N8N_BASIC_AUTH_PASSWORD_HASH}
	}
	reverse_proxy n8n:5678
}

# Clerk-style docs site — pure static, served by Caddy directly from a mounted dir
docs.{$DOMAIN} {
	encode zstd gzip
	root * /srv/docs
	redir / /quickstart 301
	try_files {path} {path}/ {path}.html /index.html
	file_server
	header /_public/* Cache-Control "public, max-age=31536000, immutable"
}
