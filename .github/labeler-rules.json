{
  "rules": [
    { "label": "security",      "pattern": "🔒|\\bsecurity\\b|\\bssrf\\b|\\bcsrf\\b|\\bxss\\b|sanitize|crypto|insecure|vulnerab" },
    { "label": "code-health",   "pattern": "🧹|code\\s*health|\\bany\\s*type|refactor|cleanup|\\blint\\b|dead\\s*code" },
    { "label": "tests",         "pattern": "🧪|^test:|\\btests?\\b|coverage|vitest|pytest|jest|spec\\.ts" },
    { "label": "performance",   "pattern": "⚡|\\bperf\\b|performance|asyncio|threadpool|n\\+1" },
    { "label": "docs",          "pattern": "📚|^docs?:|documentation|README|\\.md\\b" },
    { "label": "feature",       "pattern": "✨|^feat[:(]|\\bfeature\\b" },
    { "label": "bugfix",        "pattern": "^fix[:(]|🐛|\\bbug\\b|hotfix" },
    { "label": "jules-bot",     "pattern": "Jules\\s+for\\s+task|google-labs-jules" }
  ],
  "fallback_label": "chore"
}
