{
  "name": "ag-associates-root",
  "version": "1.0.0",
  "description": "Root package.json for Cloudflare deployments",
  "private": true,
  "scripts": {
    "build": "echo 'Root build step' && cd ag-platform && npm install && npm run build && cd ../ag-associates-ai/frontend && npm install && npm run build",
    "deploy": "echo 'Deploying'"
  },
  "workspaces": [
    "ag-platform",
    "ag-platform/apps/*",
    "ag-platform/packages/*",
    "ag-platform/services/*",
    "ag-associates-ai/frontend"
  ]
}
