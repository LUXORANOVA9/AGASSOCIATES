# ============================================================================
# AG Associates — Production environment (single VPS, docker-compose.prod.yml)
# ============================================================================
# Copy to /srv/ag/.env on the VPS, mode 0600, owner = deploy user.
# Generate strong secrets with: openssl rand -hex 32
# ============================================================================

# --- Public hostnames -------------------------------------------------------
DOMAIN=agassociates.example.com
ACME_EMAIL=admin@example.com

# --- Image tag (CI overrides per-deploy) ------------------------------------
IMAGE_TAG=latest

# --- Postgres (self-hosted on VPS, pgvector enabled) ------------------------
POSTGRES_USER=ag_admin
POSTGRES_DB=legal_templates_db
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_24

# --- Supabase Cloud (Auth + multi-tenant case data + RLS) -------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=REPLACE_WITH_SUPABASE_JWT_SECRET

# --- LLM (Groq free tier or Gemini OpenAI-compatible) -----------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.1-70b-versatile
LLM_API_KEY=gsk_REPLACE_WITH_GROQ_API_KEY

# --- Google Gemini (used by ag-platform's @ag/ai package) -------------------
GOOGLE_GENERATIVE_AI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# --- Internal service URLs --------------------------------------------------
# ag-platform's Express server posts to the AI backend when a case moves to
# IN_PROGRESS. In compose this is overridden to http://ai-backend:8000 (set
# in docker-compose.prod.yml); only override here for non-compose deployments.
# AI_BACKEND_URL=http://ai-backend:8000

# --- Transactional email (magic links, notifications) -----------------------
RESEND_API_KEY=re_REPLACE_WITH_RESEND_KEY

# --- n8n basic auth (Caddy gate) --------------------------------------------
# Generate hash with: docker run --rm caddy:2 caddy hash-password --plaintext "mypass"
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD_HASH=REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT

# --- WhatsApp Business Cloud (n8n trigger flow) -----------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_openssl_rand_hex_16

# --- NeSL filing ------------------------------------------------------------
# NESL_USE_MOCK=true returns a synthetic NESL-XXXX transaction id (default).
# Flip to false only once NESL_API_BASE_URL + NESL_API_KEY are provisioned and
# the request/response mapping in ProductionNeslClient is implemented.
NESL_USE_MOCK=true
NESL_API_BASE_URL=
NESL_API_KEY=
NESL_REQUEST_TIMEOUT_SEC=30
NESL_MOCK_DELAY_SEC=3

# --- Backups (restic + Backblaze B2 or Hetzner Storage Box) -----------------
RESTIC_REPOSITORY=b2:ag-backups:/agassociates
RESTIC_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# --- Sentry (optional, leave blank to disable) ------------------------------
SENTRY_DSN_BACKEND=
SENTRY_DSN_PLATFORM=
