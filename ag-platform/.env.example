# =============================================================================
# AG ASSOCIATES — Environment Variables
# Copy to .env and fill in all values
# =============================================================================

# --- Server ---
PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ag_platform
DB_SSL=false

# --- Supabase (Auth + Storage) ---
# Create a project at https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI ---
# Gemini API key from https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
AI_BACKEND_URL=http://127.0.0.1:8001
VITE_AI_BACKEND_URL=http://localhost:8000
VITE_AI_ADMIN_KEY=your-ai-admin-key

# --- Email (Resend) ---
# From https://resend.com
RESEND_API_KEY=re_xxxxx

# --- Dev Mode (set true to bypass Supabase auth) ---
VITE_DEV_MODE=true
