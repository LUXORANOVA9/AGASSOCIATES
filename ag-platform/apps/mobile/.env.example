# Copy to .env for local development. EAS Build reads these from EAS Secrets.
# NEVER commit a real .env — only this example file is tracked.

# Supabase (same project as the web app — RLS keeps tenants isolated)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# FastAPI backend base URL — RN never calls Gemini/OpenAI directly
EXPO_PUBLIC_API_BASE_URL=https://api.agassociates.example.com

# Sentry (leave blank to disable in dev)
EXPO_PUBLIC_SENTRY_DSN=

# Public privacy policy URL (referenced from app stores + in-app)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://agassociates.example.com/privacy
