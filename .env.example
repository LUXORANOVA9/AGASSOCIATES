# AG ASSOCIATES — Environment Variables
# Copy this to .env next to docker-compose.prod.yml and fill in real values.
# Generate strong secrets with: openssl rand -hex 32

# ── Domain ────────────────────────────────────────────────
DOMAIN=agassociates.example.com
ACME_EMAIL=admin@example.com

# ── Docker image tag (optional, defaults to "latest") ─────
# Pin to a specific SHA for rollback: IMAGE_TAG=<sha>
IMAGE_TAG=latest

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=ag_user
POSTGRES_PASSWORD=changeme_prod_password
POSTGRES_DB=ag_prod

# ── Redis (OTP bridge, caching, NOI case store) ───────────
REDIS_PASSWORD=changeme_redis_password

# ── AI Backend ────────────────────────────────────────────
# For production use Groq (free tier): https://console.groq.com
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_your_groq_key
# Or Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.1-70b-versatile
LLM_API_KEY=gsk_your_groq_key
LLM_MOCK_MODE=false

# ── Supabase ──────────────────────────────────────────────
# Create a free project at https://supabase.com, then copy these from Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret_from_supabase_settings

# ── JWT / Auth (for NOI workflow webhooks) ────────────────
JWT_SECRET=

# ── Environment ───────────────────────────────────────────
ENVIRONMENT=production
SENTRY_DSN=

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key

# ── Email Intake Agent (IMAP) ─────────────────────────────
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=advadiityagade@gmail.com
EMAIL_IMAP_PASS=your_app_password
EMAIL_POLL_INTERVAL=60

# ── Telegram OTP Bot ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ADMIN_CHAT_IDS=123456789,987654321

# ── n8n (WhatsApp + Orchestration) ────────────────────────
N8N_BASIC_AUTH_USER=admin
# Generate: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
N8N_BASIC_AUTH_PASSWORD_HASH=bcrypt_hashed_password_here
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
N8N_WEBHOOK_KEY=
N8N_WHATSAPP_INBOUND_KEY=
N8N_WHATSAPP_SEND_URL=

# ── NeSL / IGR Production E-Filing ────────────────────────
# Mode selection (auto):
#   API mode — set NESL_API_KEY and NESL_CLIENT_ID/SECRET
#   RPA mode — set IGR_PORTAL_USERNAME/PASSWORD (Playwright Web automation)
#   Mock mode — neither set, returns fake acknowledgment
NESL_API_KEY=
NESL_API_BASE_URL=https://api.nesl.co.in/v1
NESL_CLIENT_ID=
NESL_CLIENT_SECRET=
NESL_MOCK_DELAY_SEC=3

# IGR Maharashtra e-filing portal (RPA fallback)
IGR_PORTAL_URL=https://igrmaharashtra.gov.in/efiling/
IGR_PORTAL_USERNAME=
IGR_PORTAL_PASSWORD=

# GRAS challan portal
GRAS_PORTAL_URL=https://gras.mahakosh.gov.in/echallan/

# IGR/GRAS DOM selectors — override any to match portal changes (see igr_executor.py / executor_agent.py)
# IGR_SEL_USERNAME=input[name='username']
# IGR_SEL_PASSWORD=input[name='password']
# IGR_SEL_OTP=input[id='otp']
# GRAS_SEL_PAY_WO_REG=text=Pay Without Registration
# GRAS_SEL_GRN=span#grn_number

# Document paths for IGR upload
# IGR_DOC_PATH_SANCTION_LETTER=/srv/ag/documents/{case_id}/sanction_letter.pdf
# IGR_DOC_PATH_BORROWER_KYC=/srv/ag/documents/{case_id}/borrower_kyc.pdf
# IGR_DOC_PATH_STAMP_DUTY_RECEIPT=/srv/ag/documents/{case_id}/stamp_duty_receipt.pdf

# ── Google Generative AI (used by ag-platform) ────────────
GOOGLE_GENERATIVE_AI_API_KEY=
