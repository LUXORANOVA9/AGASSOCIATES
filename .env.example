# ── Domain ───────────────────────────────────────────────────────────
DOMAIN=advadiityagade.com
ACME_EMAIL=admin@advadiityagade.com

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=agdb
DATABASE_URL=postgresql://postgres:replace_with_secure_password@localhost:5432/agdb

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace_with_secure_redis_password

# ── Caddy / n8n basicauth ───────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD_HASH=bcrypt_hash_from_caddy_hash_password

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── LLM / AI ─────────────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=qwen2.5-7b-instruct
LLM_API_KEY=your-llm-api-key
LLM_MOCK_MODE=false
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── n8n / Backend Auth ───────────────────────────────────────────────
N8N_WEBHOOK_KEY=openssl_rand_hex_32
VOICE_ADMIN_KEY=openssl_rand_hex_32
JWT_SECRET=openssl_rand_hex_32

# ── Telegram Bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=8834872394
TELEGRAM_WEBHOOK_SECRET=openssl_rand_hex_32
TELEGRAM_WEBHOOK_HOST=https://api.advadiityagade.com

# ── WhatsApp ─────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ── NeSL e-Filing ────────────────────────────────────────────────────
NESL_USE_MOCK=true
NESL_API_BASE_URL=https://api.nesl.co.in/v1
NESL_API_KEY=
NESL_CLIENT_ID=
NESL_CLIENT_SECRET=
NESL_MOCK_DELAY_SEC=3

# ── IGR Portal ───────────────────────────────────────────────────────
IGR_PORTAL_URL=
IGR_PORTAL_USERNAME=
IGR_PORTAL_PASSWORD=

# ── GRAS Portal ──────────────────────────────────────────────────────
GRAS_PORTAL_URL=https://gras.mahakosh.gov.in/echallan/

# ── Email Intake ─────────────────────────────────────────────────────
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=

# ── Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
RESEND_API_KEY=

# ── Observability ────────────────────────────────────────────────────
SENTRY_DSN=
ENVIRONMENT=development

# ── Backend (direct) ─────────────────────────────────────────────────
AI_BACKEND_URL=http://localhost:8000
VITE_AI_BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=/api

# ── Auth ─────────────────────────────────────────────────────────────
VITE_DEV_MODE=true
VITE_AI_ADMIN_KEY=dev-admin-key
